# Nexmon Gain Recovery V2 firmware and its matching mcp/nexutil are required.
# csi_extract.sh configures the radio and starts the receiver in nexmon-csi.
NEXMON_IFACE=wlan0
NEXMON_MONITOR_IFACE=mon0
CHANNEL_NUM=9
BANDWIDTH=20
# Matches the previous launcher's -l106; must match your mcp/firmware pair.
NEXMON_CONFIG_LENGTH=106

# Comma-separated transmitter MAC addresses; blank accepts all transmitters.
# Example: TX_MAC_ADDRESS=AA:BB:CC:DD:EE:FF,00:11:22:33:44:55
# Up to four are also applied in firmware. Longer lists use software filtering.
TX_MAC_ADDRESS=

# No run name: daily csi_YYYY-MM-DD.db (UTC), each with MAC_addr + CSI_frame.
# Named run: data/<name>-YYYY-MM-DD-HH_MM_SS.db using the Pi's local start time.
# Relative paths are resolved beside this .env file.
CSI_DAILY_DIR=/home/pi/secure_mount/data/csi_daily
DB_BATCH_SIZE=500
WRITE_INTERVAL_MS=1000
LOG_LEVEL=INFO
STATS_LOG_INTERVAL_SEC=30

# Optional CSI forwarding. Local database recording is always enabled.
# true = plain TCP, false = no connection to the control server.
# Comma-separated numeric IPv4/IPv6 addresses, all using TCP_PORT.
# Example: CONTROL_IP=192.168.1.100,192.168.1.101
# Each destination has its own subprocess and bounded queue.
# The server must accept the legacy length-prefixed pickle protocol without
# TLS, receiver authentication or MQTT registration. Restart after changing .env.
SEND_CSI_DATA=false
CONTROL_IP=192.168.0.254
TCP_PORT=8080
SOCKET_TIMEOUT=5
SEND_QUEUE_BATCHES=20
# Shared time budget to drain all forwarding queues before stopping subprocesses.
SEND_SHUTDOWN_TIMEOUT_SEC=3
# Blank reads the MAC of NEXMON_IFACE. Set only to override receiver identity.
RX_MAC_ADDRESS=
